PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/contribution-finder
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
# Optional: increases the GitHub search rate limit. Never expose this in client config.
GITHUB_TOKEN=

# Provider apps are registered in your Google / GitHub developer accounts.
API_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
